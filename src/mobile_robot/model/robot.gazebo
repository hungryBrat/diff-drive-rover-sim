<?xml version="1.0"?>

<robot>

<gazebo reference="body_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/Yellow</material>
</gazebo>

<gazebo reference="wheel1_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/Red</material>
</gazebo>

<gazebo reference="wheel2_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/Red</material>
</gazebo>

<gazebo reference="caster_link">
    <mu1>0.000002</mu1>
    <mu2>0.000002</mu2>
    <material>Gazebo/Blue</material>
</gazebo>

<gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <sensor name="lidar_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/scan</topic>
        <frame_id>lidar_link</frame_id> 
        <update_rate>10</update_rate>
        <lidar>
            <scan>
                <horizontal>
                    <samples>360</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14</min_angle>
                    <max_angle>3.14</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.1</min>
                <max>12.0</max>
                <resolution>0.005</resolution>
            </range>
            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.001</stddev>
            </noise>
        </lidar>
        <always_on>1</always_on>
        <visualize>1</visualize>
    </sensor>
</gazebo>

<!-- ros2_control plugin -->
<gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find mobile_robot)/parameters/controllers.yaml</parameters>

        <!-- None of the below belong to gz_ros2_control. Those were 
            DiffDrive-plugin parameters. gz_ros2_control is a different 
            plugin with a completely different job — it doesn't know what
            a wheel or a cmd_vel topic is. Its only job is: "load the 
            controllers.yaml and run a controller_manager." All that
            wheel/topic/frame configuration now lives inside 
            controllers.yaml and diff_drive_controller — which is the 
            whole point of the migration.-->
        <!-- <right_joint>wheel1_joint</right_joint>
        <left_joint>wheel2_joint</left_joint>
        <wheel_separation>${2*s4}</wheel_separation>
        <wheel_radius>${r}</wheel_radius>
        <max_linear_acceleration>10</max_linear_acceleration>
        <topic>/cmd_vel</topic>
        <tf_topic>/tf</tf_topic>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publisher_frequency>30</odom_publisher_frequency> -->
    </plugin>
</gazebo>

<!-- Joint State Publisher is now handled by joint_state_broadcaster; the below is defunct-->
<!-- <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
        <joint_name>wheel1_joint</joint_name>
        <joint_name>wheel2_joint</joint_name>
        <joint_name>lidar_joint</joint_name>
    </plugin>
</gazebo> -->

<!-- NOTE: gz-sim-sensors-system moved to empty_sensors.sdf         -->
<!-- It must be a world-level plugin in Gazebo Harmonic (v8.x),     -->
<!-- not a robot-level plugin. Keeping it here caused the           -->
<!-- pause/play flicker and sim/real-time drift.                    -->

</robot>

<!-- Controllers don't auto-start. The gz_ros2_control plugin creates 
    a controller_manager when the robot loads, but it comes up with 
    zero controllers active. You have to spawn them — load + activate 
    joint_state_broadcaster and diff_drive_controller-->